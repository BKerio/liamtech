# Pulled automatically by `neon env pull` / `neon deploy` (see neon.ts).

# Neon Postgres — pooled connection string (host contains "-pooler"), used by the app at runtime
DATABASE_URL=
# Neon Postgres — direct connection string, used by Prisma for migrations / db push
DATABASE_URL_UNPOOLED=

# Neon Object Storage (bucket "assets" declared in neon.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
